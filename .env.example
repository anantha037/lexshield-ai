# LexShield AI — Environment Variables Template
# ==============================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git (it's in .gitignore).
#
# Usage: cp .env.example .env
#        (then edit .env with real values)
# ─────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────
# LLM API Keys
# ─────────────────────────────────────────────────────────────

# Groq — Primary LLM (LLaMA 3.3 70B, free tier)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini — DraftingAgent primary + Groq fallback
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM — Optional, alternative LLM provider
# Get key: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenRouter — Optional fallback LLM gateway
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here


# ─────────────────────────────────────────────────────────────
# Indian Kanoon API (Case Law Search — Session 4)
# ─────────────────────────────────────────────────────────────
# Get key: https://api.indiankanoon.org
IK_API_TOKEN=your_indiankanoon_api_key_here

# Enable/disable case law enrichment in RAG responses
# Set to "false" to skip Indian Kanoon calls (faster, saves quota)
ENABLE_CASE_LAW_ENRICHMENT=true


# ─────────────────────────────────────────────────────────────
# LangSmith Observability (Session 5 — free tier)
# ─────────────────────────────────────────────────────────────
# Get key: https://smith.langchain.com
# View traces at: https://smith.langchain.com/projects/lexshield-ai
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=lexshield-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# ─────────────────────────────────────────────────────────────
# Authentication (Session 6)
# ─────────────────────────────────────────────────────────────
# JWT secret key — MUST be changed in production!
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=please-change-this-to-a-random-32-char-secret-string

# JWT token expiry in days (default: 7)
# JWT_EXPIRY_DAYS=7


# ─────────────────────────────────────────────────────────────
# CORS (Session 6)
# ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Default covers Next.js (3000) and Vite (5173) dev servers
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
HF_TOKEN=hf_token_here


# ─────────────────────────────────────────────────────────────
# Database (optional override)
# ─────────────────────────────────────────────────────────────
# SQLite (default, local, zero-config)
# DATABASE_URL=sqlite:///./lexshield.db

# To switch to PostgreSQL in future (never for this project):
# DATABASE_URL=postgresql://user:pass@localhost:5432/lexshield
DATABASE_URL=postgresql://lexshield:lexshield@localhost:5433/lexshield_sessions

# ─────────────────────────────────────────────────────────────
# Hardware / Performance (Windows 11, i5-8250U, 8GB RAM, no GPU)
# ─────────────────────────────────────────────────────────────
# These are set programmatically in api/main.py and rag/embedder.py
# but can be overridden here if needed
# OMP_NUM_THREADS=2
# MKL_NUM_THREADS=2


# ─────────────────────────────────────────────────────────────
# ChromaDB Vector Store
# ─────────────────────────────────────────────────────────────
# CHROMA_MODE=local   → uses PersistentClient (default, no extra keys needed)
# CHROMA_MODE=cloud   → uses HttpClient against Chroma Cloud
CHROMA_MODE=local

# Required only when CHROMA_MODE=cloud:
# Get from: https://cloud.trychroma.com
# CHROMA_API_KEY=your_chroma_cloud_api_key_here
# CHROMA_TENANT=your_chroma_tenant_here
# CHROMA_DATABASE=your_chroma_database_here
